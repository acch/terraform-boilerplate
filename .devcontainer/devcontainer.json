{
  "name": "terraform-boilerplate",

  "build": {
    "dockerfile": "Dockerfile"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "hashicorp.terraform",
        "redhat.vscode-yaml"
      ]
    }
  },

  "securityOpt": ["label=disable"],
  "mounts": [],

  "workspaceMount": "type=bind,source=${localWorkspaceFolder},target=/src,ro=false",
  "workspaceFolder": "/src",

  "remoteEnv": {
    "ARM_SUBSCRIPTION_ID": "${localEnv:ARM_SUBSCRIPTION_ID}",
    "ARM_CLIENT_ID": "${localEnv:ARM_CLIENT_ID}",
    "ARM_CLIENT_SECRET": "${localEnv:ARM_CLIENT_SECRET}",
    "ARM_TENANT_ID": "${localEnv:ARM_TENANT_ID}"
  }
}
